{
  "rules": {
    ".read": true,
    ".write": false,
    "students": {
      ".write": true,
      ".indexOn": ["login_id", "teacher_id", "class_id"]
    },
    "teachers": {
      ".write": true,
      ".indexOn": ["class_id"]
    },
    "notice": {
      ".write": true
    },
    "live_classes": {
      ".write": true
    },
    "subjects": {
      ".write": true
    },
    "subject_notes": {
      ".write": true
    },
    "recorded_classes": {
      ".write": true,
      "$classId": {
        ".indexOn": ["date"]
      }
    }
  }
}
